<!DOCTYPE html>
<html>

<head>
    <title>User registration</title>
    <link rel="stylesheet" href="/css/register.css">
</head>
 
<body>

<div class="page-layout">

    <div class="illustration">
        <img src="/img/register-illustration.svg" alt="Registration illustration" class="illustration-image">

    </div>

    <div class="container register-box">

        <div class="ui-panel" style="text-align: left; margin-bottom: 24px;">
            <div class="ui-content">
                <div style="display: flex; align-items: center; justify-content: flex-start; gap: 12px; margin-bottom: 8px;">
                    <span aria-hidden="true" style="width: 36px; height: 36px; border-radius: 8px; background: linear-gradient(135deg, #4f74ff, #2f49d6); color: #ffffff; display: inline-flex; align-items: center; justify-content: center;">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                        </svg>
                    </span>
                    <span style="font-size: 34px; font-weight: 700; color: var(--text);">ProTrack</span>
                </div>
                <h2 style="font-size: 16px; font-weight: 500; color: var(--muted); margin: 0; text-transform: uppercase; letter-spacing: 0.5px;">User Registration</h2>
            </div>
        </div>

        <div id="successPopup" class="popup-overlay hidden">
            <div class="popup-card">
                <h3 id="popupTitle">Registration Successful</h3>
                <p id="popupText">Your account has been created.</p>
                <button id="popupOkButton" type="button">OK</button>
            </div>
        </div>

        <form id="registerForm">

        <div class="form-grid">

        <div class="form-group">
            <label>First Name</label>
            <input type="text" name="firstName" id="firstName" placeholder="Enter first name" required>
        </div>

        <div class="form-group">
            <label>Last Name</label>
            <input type="text" name="lastName" id="lastName" placeholder="Enter last name" required>
        </div>

        <div class="form-group">
            <label>Phone Number</label>
            <input type="text" name="phone" id="phone" placeholder="Enter phone number" required>
        </div>

        <div class="form-group">
            <label>Email Address</label>
            <input type="email" name="email" id="email" placeholder="Enter email" required>
        </div>

        <div class="form-group">
            <label>Password</label>
            <div class="password-wrap">
                <input type="password" name="password" id="password" placeholder="Enter password" required>
                <button type="button" class="eye-button" data-target="password" aria-label="Toggle password visibility">
                    <span class="eye-icon" aria-hidden="true"></span>
                </button>
            </div>

        </div>

        <div class="form-group">
            <label>Confirm Password</label>
            <div class="password-wrap">
                <input type="password" name="confirmPassword" id="confirmPassword" placeholder="Confirm password" required>
                <button type="button" class="eye-button" data-target="confirmPassword" aria-label="Toggle confirm password visibility">
                    <span class="eye-icon" aria-hidden="true"></span>
                </button>
            </div>
        </div>

        </div>

        <span id="passwordMatchHint" class="field-error hint-left"></span>

        <button type="submit">Submit</button>

        <p class="login-text">
            Already registered? <a href="/login">Login here</a>
        </p>

        </form>

    </div>

</div>

<script src="/js/register.js"></script>

</body>
</html>