<aside id="mySidenav" class="sidebar card sidenav" aria-hidden="true">
<button type="button" id="closeSidebarBtn" class="closebtn" aria-label="Close sidebar">&times;</button>
<nav class="sidebar-nav" aria-label="Sidebar navigation">

  <%-- Dashboard — all roles --%>
  <a href="/dashboard" class="nav-link <%= activePage === 'dashboard' ? 'active' : '' %>">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
    <span>Dashboard</span>
  </a>

  <%-- Users — super_admin and admin only --%>
  <% if (sessionUser && (sessionUser.role === 'super_admin' || sessionUser.role === 'admin')) { %>
  <a href="/users-page" class="nav-link <%= activePage === 'users' ? 'active' : '' %>">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
    <span>Users</span>
  </a>
  <% } %>

  <%-- Projects — all roles --%>
  <a href="/projects-page" class="nav-link <%= activePage === 'projects' ? 'active' : '' %>">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
    <span>Projects</span>
  </a>

  <%-- Tasks — all roles --%>
  <a href="/tasks-page" class="nav-link <%= activePage === 'tasks' ? 'active' : '' %>">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
    <span>Tasks</span>
  </a>

  <%-- Kanban — all roles --%>
  <a href="/kanban-page" class="nav-link <%= activePage === 'kanban' ? 'active' : '' %>">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="6" height="20" rx="1"/><rect x="10" y="2" width="6" height="14" rx="1"/><rect x="18" y="2" width="4" height="10" rx="1"/></svg>
    <span>Kanban</span>
  </a>

  <%-- Calendar — all roles --%>
  <a href="/calendar-page" class="nav-link <%= activePage === 'calendar' ? 'active' : '' %>">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
    <span>Calendar</span>
  </a>

  <%-- Reports — managers and above --%>
  <% if (sessionUser && ['super_admin','admin','project_manager'].includes(sessionUser.role)) { %>
  <a href="/reports-page" class="nav-link <%= activePage === 'reports' ? 'active' : '' %>">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="16" y2="17"/></svg>
    <span>Reports</span>
  </a>
  <% } %>

  <%-- Activity Log — admin only --%>
  <% if (sessionUser && (sessionUser.role === 'super_admin' || sessionUser.role === 'admin')) { %>
  <a href="/activity-page" class="nav-link <%= activePage === 'activity' ? 'active' : '' %>">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
    <span>Activity Log</span>
  </a>
  <% } %>

  <%-- Profile — all roles --%>
  <a href="/profile" class="nav-link <%= activePage === 'profile' ? 'active' : '' %>">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
    <span>My Profile</span>
  </a>

</nav>

<% if (sessionUser) { %>
<div class="sidebar-user-info">
  <span class="role-badge role-<%= sessionUser.role %>"><%= sessionUser.role.replaceAll('_', ' ') %></span>
</div>
<% } %>

<form action="/logout" method="POST" style="margin:0;">
  <button type="submit" class="nav-link logout-link-side" style="background:none;border:none;width:100%;text-align:left;cursor:pointer;">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
    <span>Log Out</span>
  </button>
</form>
</aside>
