<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Access Denied — ProTrack</title>
<link rel="stylesheet" href="/css/access-denied.css?v=20260422">
</head>

<body>
<div class="denied-page">

  <div class="denied-card">
    <div class="denied-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="12" cy="12" r="10"/>
        <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
      </svg>
    </div>

    <h1 class="denied-code">403</h1>
    <h2 class="denied-title">Access Denied</h2>
    <p class="denied-message">
      You don't have permission to view this page.
      <% if (typeof sessionUser !== 'undefined' && sessionUser) { %>
      Your current role is <strong><%= sessionUser.role.replace(/_/g, ' ') %></strong>.
      <% } %>
    </p>

    <div class="denied-actions">
      <a href="/dashboard" class="denied-btn denied-btn--primary">Go to Dashboard</a>
      <a href="javascript:history.back()" class="denied-btn denied-btn--secondary">Go Back</a>
    </div>
  </div>

</div>
</body>
</html>
