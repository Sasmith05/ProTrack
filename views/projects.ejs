<!DOCTYPE html>
<html>

<head>
<title>Projects Dashboard</title>
<link rel="stylesheet" href="/css/projects.css?v=20260422">
</head>

<body>
<div class="page-shell">
<% const canManage = sessionUser && ['super_admin','admin','project_manager'].includes(sessionUser.role); %>
<%- include('partials/topbar', { buttonId: canManage ? 'openAddProjectModal' : '', buttonLabel: 'Add Project' }) %>

<% if (canManage) { %>
<section id="addProjectModal" class="modal-overlay hidden" aria-hidden="true">
<div class="modal-card">
<div class="modal-header">
<h2>Add New Project</h2>
<button type="button" id="closeAddProjectModal" class="modal-close" aria-label="Close">x</button>
</div>
<form id="addProjectForm" class="form-grid">
<div class="form-group form-group-full">
<label for="addProjectName">Project Name</label>
<input type="text" id="addProjectName" required>
</div>
<div class="form-group form-group-full">
<label for="addProjectDescription">Description</label>
<input type="text" id="addProjectDescription" required>
</div>
<div class="form-group">
<label for="addProjectStartDate">Start Date</label>
<input type="date" id="addProjectStartDate" required>
</div>
<div class="form-group">
<label for="addProjectEndDate">End Date</label>
<input type="date" id="addProjectEndDate" required>
</div>
<div class="form-group form-group-full">
<label for="addProjectStatus">Status</label>
<select id="addProjectStatus">
<option value="ongoing" selected>Ongoing</option>
<option value="completed">Completed</option>
<option value="on_hold">On Hold</option>
</select>
</div>
<div class="actions form-group-full split-actions">
<button type="submit">Add Project</button>
<button type="button" id="cancelAddProject" class="secondary">Cancel</button>
</div>
</form>
<p id="addProjectMessage" class="status-text"></p>
</div>
</section>

<section id="editProjectModal" class="modal-overlay hidden" aria-hidden="true">
<div class="modal-card">
<div class="modal-header">
<h2>Edit Project</h2>
<button type="button" id="closeEditProjectModal" class="modal-close" aria-label="Close">x</button>
</div>
<form id="editProjectForm" class="form-grid">
<input type="hidden" id="editProjectId">
<div class="form-group form-group-full">
<label for="editProjectName">Project Name</label>
<input type="text" id="editProjectName" required>
</div>
<div class="form-group form-group-full">
<label for="editProjectDescription">Description</label>
<input type="text" id="editProjectDescription" required>
</div>
<div class="form-group">
<label for="editProjectStartDate">Start Date</label>
<input type="date" id="editProjectStartDate" required>
</div>
<div class="form-group">
<label for="editProjectEndDate">End Date</label>
<input type="date" id="editProjectEndDate" required>
</div>
<div class="form-group form-group-full">
<label for="editProjectStatus">Status</label>
<select id="editProjectStatus">
<option value="ongoing">Ongoing</option>
<option value="completed">Completed</option>
<option value="on_hold">On Hold</option>
</select>
</div>
<div class="actions form-group-full split-actions">
<button type="submit">Save Changes</button>
<button type="button" id="cancelProjectEdit" class="secondary">Cancel</button>
</div>
</form>
<p id="editProjectMessage" class="status-text"></p>
</div>
</section>
<% } %>

<main class="layout-main">
<%- include('partials/sidebar', { activePage: activePage }) %>
<div id="sidebarOverlay" class="sidebar-overlay hidden" aria-hidden="true"></div>

<section class="content-area">
<section class="page-context" aria-label="Page context">
<p class="page-kicker">Projects Dashboard</p>
</section>
<div class="grid-layout">
<section class="card users-card">
<div class="users-header">
<h2>All Projects</h2>
</div>
<p id="projectsMessage" class="status-text"></p>
<div class="table-wrap">
<table>
<thead>
<tr>
<th>Project Name</th>
<th>Description</th>
<th>Start Date</th>
<th>End Date</th>
<th>Status</th>
<% if (canManage) { %><th>Actions</th><% } %>
</tr>
</thead>
<tbody id="projectsTableBody"></tbody>
</table>
</div>
</section>
</div>
</section>
</main>
</div>

<script>
  window.__SESSION_ROLE = '<%= sessionUser ? sessionUser.role : "" %>';
  window.__CAN_MANAGE = <%= canManage ? 'true' : 'false' %>;
</script>
<script src="/js/projects.js?v=20260422"></script>

</body>

</html>
