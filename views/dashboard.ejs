<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard — ProTrack</title>
<meta name="description" content="ProTrack analytics dashboard — view user and project statistics at a glance.">
<link rel="stylesheet" href="/css/usersc.css?v=20260422">
<link rel="stylesheet" href="/css/dashboard.css?v=20260422">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
</head>

<body>
<div class="page-shell">
<%- include('partials/topbar', { buttonId: '', buttonLabel: '' }) %>

<main class="layout-main">
<%- include('partials/sidebar', { activePage: 'dashboard' }) %>
<div id="sidebarOverlay" class="sidebar-overlay hidden" aria-hidden="true"></div>

<section class="content-area">
  <section class="page-context" aria-label="Page context">
    <p class="page-kicker">Dashboard Overview</p>
  </section>

  <!-- ── Stat Cards ─────────────────────────────────────────── -->
  <div class="stat-cards">

    <div class="stat-card stat-card--blue">
      <div class="stat-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </div>
      <div class="stat-body">
        <p class="stat-label">Total Users</p>
        <p class="stat-value" id="statTotalUsers"><%= stats.totalUsers %></p>
      </div>
    </div>

    <div class="stat-card stat-card--green">
      <div class="stat-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      </div>
      <div class="stat-body">
        <p class="stat-label">Active Users</p>
        <p class="stat-value" id="statActiveUsers"><%= stats.activeUsers %></p>
      </div>
    </div>

    <div class="stat-card stat-card--purple">
      <div class="stat-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
      </div>
      <div class="stat-body">
        <p class="stat-label">Total Projects</p>
        <p class="stat-value" id="statTotalProjects"><%= stats.totalProjects %></p>
      </div>
    </div>

    <div class="stat-card stat-card--teal">
      <div class="stat-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
      </div>
      <div class="stat-body">
        <p class="stat-label">Completed Projects</p>
        <p class="stat-value" id="statCompletedProjects"><%= stats.completedProjects %></p>
      </div>
    </div>

    <div class="stat-card stat-card--orange">
      <div class="stat-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
      <div class="stat-body">
        <p class="stat-label">Ongoing Projects</p>
        <p class="stat-value" id="statOngoingProjects"><%= stats.ongoingProjects %></p>
      </div>
    </div>

  </div>

  <!-- ── Charts Row ─────────────────────────────────────────── -->
  <div class="charts-row">
    <div class="chart-card">
      <h3 class="chart-title">User Status</h3>
      <div class="chart-wrap">
        <canvas id="userStatusChart" aria-label="User status distribution chart"></canvas>
      </div>
    </div>
    <div class="chart-card">
      <h3 class="chart-title">Project Status</h3>
      <div class="chart-wrap">
        <canvas id="projectStatusChart" aria-label="Project status distribution chart"></canvas>
      </div>
    </div>
  </div>

  <!-- ── Recent Activity + Quick Actions ───────────────────── -->
  <div class="activity-row">

    <div class="activity-card">
      <div class="activity-header">
        <h3>Recent Users</h3>
        <% if (sessionUser && (sessionUser.role === 'super_admin' || sessionUser.role === 'admin')) { %>
        <a href="/users-page" class="activity-link">View all →</a>
        <% } %>
      </div>
      <ul class="activity-list" id="recentUsersList">
        <% recentUsers.forEach(function(u) { %>
        <li class="activity-item">
          <div class="activity-avatar"><%= u.first_name.charAt(0).toUpperCase() %></div>
          <div class="activity-info">
            <span class="activity-name"><%= u.first_name %> <%= u.last_name %></span>
            <span class="activity-sub"><%= u.email %></span>
          </div>
          <span class="badge badge--<%= u.status %>"><%= u.status %></span>
        </li>
        <% }); %>
        <% if (!recentUsers.length) { %>
        <li class="activity-empty">No users yet.</li>
        <% } %>
      </ul>
    </div>

    <div class="activity-card">
      <div class="activity-header">
        <h3>Recent Projects</h3>
        <a href="/projects-page" class="activity-link">View all →</a>
      </div>
      <ul class="activity-list" id="recentProjectsList">
        <% recentProjects.forEach(function(p) { %>
        <li class="activity-item">
          <div class="activity-avatar project-avatar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/></svg>
          </div>
          <div class="activity-info">
            <span class="activity-name"><%= p.project_name %></span>
            <span class="activity-sub">Due: <%= p.end_date ? new Date(p.end_date).toLocaleDateString('en-IN') : '—' %></span>
          </div>
          <span class="badge badge--<%= p.status %>"><%= p.status.replace('_',' ') %></span>
        </li>
        <% }); %>
        <% if (!recentProjects.length) { %>
        <li class="activity-empty">No projects yet.</li>
        <% } %>
      </ul>
    </div>

    <!-- Quick Actions -->
    <div class="activity-card quick-actions-card">
      <div class="activity-header"><h3>Quick Actions</h3></div>
      <div class="quick-actions">
        <% if (sessionUser && (sessionUser.role === 'super_admin' || sessionUser.role === 'admin')) { %>
        <a href="/users-page" class="quick-btn quick-btn--primary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
          Add User
        </a>
        <% } %>
        <% if (sessionUser && ['super_admin','admin','project_manager'].includes(sessionUser.role)) { %>
        <a href="/projects-page" class="quick-btn quick-btn--secondary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
          Add Project
        </a>
        <% } %>
        <a href="/profile/edit" class="quick-btn quick-btn--neutral">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          Edit Profile
        </a>
      </div>
    </div>

  </div>

</section>
</main>
</div>

<script>
  window.__STATS__ = {
    users: { active: <%= stats.activeUsers %>, inactive: <%= stats.inactiveUsers %> },
    projects: { completed: <%= stats.completedProjects %>, ongoing: <%= stats.ongoingProjects %>, on_hold: <%= stats.onHoldProjects %> }
  };
</script>
<script src="/js/dashboard.js?v=20260422"></script>

</body>
</html>
